# Preserve exact historical-code and frozen-prompt bytes for SHA256 provenance.
# -text disables newline conversion; it does not suppress readable text diffs.
/tools/exp13_cloud/** -text
/configs/exp13_cloud/** -text
/docs/exp13_cloud/** -text
/configs/exp14/repair/*.txt -text
/results/exp14_e0_e1_full_protocol/protocol.json text eol=lf
/results/exp14_e0_e1_full_protocol/execution_identity.json text eol=lf

