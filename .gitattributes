# Preserve exact historical-code and frozen-prompt bytes for SHA256 provenance.
# -text disables newline conversion; it does not suppress readable text diffs.
/tools/exp13_cloud/** -text
/configs/exp13_cloud/** -text
/docs/exp13_cloud/** -text
/configs/exp14/repair/*.txt -text
/results/exp14_e0_e1_full_protocol/protocol.json text eol=lf
/results/exp14_e0_e1_full_protocol/execution_identity.json text eol=lf

# Bind the new Exp17 execution/review source and receipts to their exact bytes.
# Historical Exp15 files retain their existing attributes and are not rewritten.
/tools/exp17/** -text
/docs/exp17/** -text
/results/exp17_j2_preparation/** -text

# Preserve exact Exp17-D reconciliation source and receipt bytes.
/tools/exp17d/** -text
/docs/exp17d/** -text
/results/exp17_d_historical_reconciliation/** -text

# Preserve Exp17-E source, display-tool and audit receipt byte identities.
/tools/exp17e/** -text
/docs/exp17e/** -text
/results/exp17e_a10_379_polygon_expansion/** -text
